# ESP-IDF 构建产物与临时目录
build/
managed_components/
sdkconfig.old
sdkconfig.ci

# C/C++ 编译产物与镜像文件
*.o
*.elf
*.bin
*.map
*.a
*.so
*.dylib

# CMake 临时生成文件（若在源码树中生成）
CMakeCache.txt
CMakeFiles/
